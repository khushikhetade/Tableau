      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0503080387428352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews] * [Review Scores Rating]' />
      </column>
      <column caption='pricing categories' datatype='string' name='[Calculation_0503080388042753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;= 300 Then &quot;Luxury&quot; &#13;&#10;ELSEIF [Price] &gt;= 150 Then &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category ' datatype='string' name='[Calculation_0503080388943874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;= 100 Then &quot;Highly Reviews&quot; &#13;&#10;ELSE &quot;Less Review&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_0503080389332995]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0503080390549510]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0503080389910533]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Host_Since' datatype='date' name='[Calculation_1436296252448768]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since], DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Neighbourhood.' datatype='string' name='[Calculation_1436296252866561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Neighbourhood], &quot;Unknown&quot;)' />
      </column>
      <column caption='Review score rating ' datatype='string' name='[Calculation_1436296253313027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]), &quot;Not Rated&quot;)' />
      </column>
      <column caption='Update_beds' datatype='integer' name='[Calculation_1436296254070788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Beds], 0)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Property Type]' role='dimension' type='nominal' />
